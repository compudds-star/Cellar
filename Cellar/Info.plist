<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Camera: required for live label scanning (VisionKit DataScanner). -->
	<key>NSCameraUsageDescription</key>
	<string>Cellar uses the camera to scan or photograph a bottle's label and read its name, producer, and vintage.</string>
	<!-- Photo library: optional path to run OCR on a picture you already took. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Cellar can read a wine label from a photo you choose from your library.</string>
	<!-- When-in-use location: only to find wine stores near you and give
	     directions. Cellar does not track you and stores no location history. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Cellar uses your location only to find nearby wine stores that carry a bottle and give directions. Your location is never stored or shared.</string>
	<!-- Local network: only to reach a development pricing proxy on your Mac over
	     Wi-Fi. iOS asks once before the app can connect to a LAN address. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Cellar connects to a pricing server on your local network to look up wine prices.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Allow cleartext ONLY to local hosts (a dev pricing proxy on your Mac at
	     http://127.0.0.1). Real remote endpoints still require HTTPS under ATS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Required for native full-screen layout; without it iOS runs the app
	     letterboxed at a legacy 320x480 size. Empty dict = plain system background. -->
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
