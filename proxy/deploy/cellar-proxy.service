[Unit]
Description=Cellar pricing proxy
After=network.target

[Service]
Type=simple
# Dedicated unprivileged user; create with: sudo useradd -r -s /usr/sbin/nologin cellar
User=cellar
Group=cellar
WorkingDirectory=/opt/cellar-proxy
# Secrets live in this root-owned, 0600 file — NOT in the unit and NOT in git.
EnvironmentFile=/etc/cellar-proxy.env
ExecStart=/usr/bin/node /opt/cellar-proxy/server.js
Restart=on-failure
RestartSec=3
# Writable state: /var/lib/cellar-proxy, created and chowned to User= by systemd.
# ProtectSystem=strict makes everything else read-only, so the cache and the device
# roster MUST live here — point CACHE_FILE and DEVICES_FILE at it in the env file.
# Without this the proxy still runs, but every save fails and the per-device
# counters and caps reset on each restart.
StateDirectory=cellar-proxy
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
