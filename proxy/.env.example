# Copy to .env and fill in. NEVER commit the real .env.
# Load it with: `set -a; . ./.env; set +a; npm start`  (or via systemd, below)

# Where the proxy listens (keep on localhost; nginx terminates TLS in front)
HOST=127.0.0.1
PORT=8787

# Which upstream to use: mock | winesearcher | apify
PROVIDER=mock

# Bearer token the APP must send (paste this same value into the app's Settings
# → API key). Rotating it instantly cuts off a leaked build. Generate one with:
#   openssl rand -hex 32
PROXY_TOKEN=

# --- Wine-Searcher (PROVIDER=winesearcher) ---
# Endpoint from your Wine-Searcher API docs, and your secret key.
WS_API_URL=
WS_API_KEY=

# --- Apify (PROVIDER=apify) ---
APIFY_TOKEN=
APIFY_ACTOR=mrbridge~vivino-wine-data-scraper
# Second actor, merged with the first: critic score + cheapest listing. "" disables it.
APIFY_WS_ACTOR=mrbridge~wine-searcher-scraper-from-list
# How long a lookup waits for that slower half before answering without it...
WS_GRACE_SECONDS=6
# ...and how long it keeps running in the background to fill the cache.
WS_TIMEOUT_SECONDS=110

# Cache each wine's result this long (default 7 days) to minimize provider calls
CACHE_TTL_SECONDS=604800
# Where the cache is kept between restarts; "" for memory only
CACHE_FILE=./cache.json

# Per-IP requests per minute
RATE_LIMIT_PER_MIN=60

# --- Per-device quotas (sharing the app with friends) ---
# Each install sends X-Cellar-Device: a short id ("Ryc#j0") from its Keychain.
# Only lookups that actually reach the provider count — cache hits are free.
DEVICES_FILE=./devices.json
# Billable lookups per device per day / per calendar month. 0 = unlimited.
# 100/day covers a full refresh of a large cellar; 300/month is ~4 full refreshes,
# which the 7-day cache means nobody legitimately needs to exceed.
DEVICE_DAILY_LIMIT=100
DEVICE_MONTHLY_LIMIT=300
# How many installs may enrol themselves. 0 = no limit.
MAX_DEVICES=10
# 0 = only ids already listed in DEVICES_FILE may look up prices.
ALLOW_UNKNOWN_DEVICES=1
# 1 = refuse requests that carry no device id at all.
REQUIRE_DEVICE=0
# Your own install's id (Settings → bottom of the screen): enrolled unlimited.
OWNER_DEVICE=
# Bearer token for GET /admin/devices (the usage view). Unset = endpoint disabled.
#   openssl rand -hex 32
ADMIN_TOKEN=

# Set to 1 to include the raw upstream provider JSON as "_raw" in the response,
# so you can correct the field mapping in server.js for your API. Turn OFF in prod.
DEBUG_UPSTREAM=0
